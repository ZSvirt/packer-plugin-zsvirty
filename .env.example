# Copy to .env, chmod 600 .env. Do not commit .env.
# Packer does not load dotenv files automatically: set -a; source .env; set +a
ZSVIRT_MANAGEMENT_IP=
ZSVIRT_PORT=8080
ZSVIRT_ACCESS_KEY_ID=
ZSVIRT_ACCESS_KEY_SECRET=
# Alternatively use account authentication, leaving both access key values empty:
# ZSVIRT_ACCOUNT_NAME=
# ZSVIRT_ACCOUNT_PASSWORD=

# Optional cloud acceptance (explicitly opt in; creates/deletes test resources):
# ZSVIRT_ACC=1
# Optional architecture (default for URL input: x86_64):
# ZSVIRT_ACC_ARCHITECTURE=aarch64
# If source image OS metadata is absent, explicitly supply both:
# ZSVIRT_ACC_PLATFORM=Linux
# ZSVIRT_ACC_GUEST_OS_TYPE=Linux
# Choose exactly one source:
# ZSVIRT_ACC_IMAGE_UUID=
# ZSVIRT_ACC_IMAGE_URL=
# Port-group UUIDs are preferred; ordinary L3-network UUIDs also work.
# Choose exactly one of NETWORK_NAME, NETWORK_UUID or comma-separated NETWORK_UUIDS.
# ZSVIRT_ACC_NETWORK_NAME=
# ZSVIRT_ACC_NETWORK_UUID=
# ZSVIRT_ACC_NETWORK_UUIDS=
# ZSVIRT_ACC_DEFAULT_NETWORK_UUID=
# ZSVIRT_ACC_ZONE_UUID=
# ZSVIRT_ACC_CLUSTER_UUID=
# ZSVIRT_ACC_HOST_UUID=
# ZSVIRT_ACC_CHECK_EXPORT=1
# ZSVIRT_ACC_IMAGE_STORAGE_UUID=
# ZSVIRT_ACC_COMMUNICATOR=ssh
# ZSVIRT_ACC_SSH_USERNAME=
# ZSVIRT_ACC_SSH_PASSWORD=
# ZSVIRT_ACC_SCENARIO=key-cleanup
# Optional Linux cloud-init payload (plaintext, use your environment loader for newlines):
# ZSVIRT_ACC_USER_DATA=
# Optional SSH bastion:
# ZSVIRT_ACC_SSH_BASTION_HOST=
# ZSVIRT_ACC_SSH_BASTION_USERNAME=
# ZSVIRT_ACC_SSH_BASTION_PASSWORD=
# Windows acceptance (configure HTTPS WinRM in the disposable source image first):
# ZSVIRT_ACC_COMMUNICATOR=winrm
# ZSVIRT_ACC_PLATFORM=WindowsVirtio
# ZSVIRT_ACC_ARCHITECTURE=x86_64
# ZSVIRT_ACC_CPU_NUM=2
# ZSVIRT_ACC_MEMORY_SIZE=4096
# ZSVIRT_ACC_WINRM_USERNAME=Administrator
# ZSVIRT_ACC_WINRM_PASSWORD=
# ZSVIRT_ACC_WINRM_USE_SSL=1
# ZSVIRT_ACC_WINRM_INSECURE=1

# Opt-in ISO installation acceptance; private JSON config may contain credentials.
ZSVIRT_ACC_ISO=0
ZSVIRT_ACC_ISO_CONFIG_FILE=
# Optional: exact UUID of an owned failed import already confirmed absent.
# ZSVIRT_ACC_ISO_CLEANUP_UUID=

# Preserve output images for manual verification; still clean temporary resources.
# ZSVIRT_ACC_KEEP_OUTPUTS=1
# Disposable AK/SK and ISO disk-offering acceptance options:
# ZSVIRT_ACC_AKSK=0
# ZSVIRT_ACC_ISO_CREATE_DISK=0

# Additional opt-in real-cloud tests:
# ZSVIRT_ACC_OFFERING=0
# ZSVIRT_ACC_NETWORK=0
# ZSVIRT_ACC_DATA_DISK=0
# Existing offering selection (omit direct sizing when configured):
# ZSVIRT_ACC_INSTANCE_OFFERING_NAME=
# ZSVIRT_ACC_INSTANCE_OFFERING_UUID=
